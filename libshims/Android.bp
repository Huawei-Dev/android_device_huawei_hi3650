cc_library_shared {
    name: "liblog_vendor",
    srcs: ["libshim_log.cpp"],
    shared_libs: ["liblog"],
    vendor: true,
}

cc_library_shared {
    name: "libshim_ui",
    srcs: ["libshim_ui.cpp"],
    shared_libs: [
        "libui",
        "libutils"
    ],
    vendor: true,
}

cc_library_shared {
    name: "guivnd",
    shared_libs: [
        "libgui_vendor",
        "libsensor_vendor"
    ],
    vendor: true,
}

cc_library_shared {
    name: "libshim_hwcam",
    shared_libs: [
        "libgui_vendor",
        "libui",
        "libshim_ui",
        "libui_shim",
        "libtinyxml2_shim"
    ],
    vendor: true,
}
