on early-init
    setprop wifi.interface wlan0
    setprop wifi.direct.interface p2p0

on post-fs-data
    # Create the directories used by the Wireless subsystem
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/ctrl 0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa_supplicant 0770 wifi wifi

    mkdir /data/vendor/bluedroid 0771 bluetooth bluetooth
    
    mkdir /data/vendor/gnss 0770 system system
    mkdir /data/vendor/cust_conn 0770 system system
    
on boot
    chown bluetooth bluetooth /dev/hwbt
    
on property:sys.conn_macs.ready=1
    # Bluetooth
    chown bluetooth bluetooth /data/vendor/bluedroid/macbt
    chmod 0666 /data/vendor/bluedroid/macbt

    # Wi-Fi
    chown wifi wifi /data/vendor/wifi/macwlan
    chmod 0666 /data/vendor/wifi/macwlan
    
service vendor.octty /vendor/bin/octty
    class core
    user system
    group system bluetooth root media
    disabled

service vendor.oam_hisi /vendor/bin/oam_hisi
    class main
    user system
    group system root wifi bluetooth
    disabled
    
service vendor.hisi_bfg /vendor/bin/start_connectivity_hisi dir_p_mode
    class late_start
    user root
    group system wifi
    oneshot
    
on property:vendor.setup_hi110x_modules=success
    start vendor.octty
    start vendor.oam_hisi
    start vendor.hsgnss
    start vendor.agnsscontrol
    start vendor.supl20clientd
    start vendor.watchlssd
    write /dev/kmsg "vendor.setup_hi110x_modules has started"
    
service vendor.hsgnss /vendor/bin/gnss_engine_hisi -normal
    class main
    user gps
    group system inet root wakelock
    disabled

service vendor.agnsscontrol /vendor/bin/gnss_control_hisi -normal
    class main
    user gps
    group system inet root wakelock
    disabled

service vendor.supl20clientd /vendor/bin/gnss_supl20clientd_hisi
    class main
    user system
    group system inet
    disabled

service vendor.watchlssd /vendor/bin/gnss_watchlssd_thirdparty
    class main
    user gps
    group system inet net_raw wakelock
    disabled

service wpa_supplicant /vendor/bin/wpa_supplicant_hisi -dd \
    -puse_p2p_group_interface=1 \
    -m/data/vendor/wifi/wpa/p2p_supplicant.conf \
    -O/data/vendor/wifi/wpa/sockets \
    -g@android:wpa_wlan0
 #  we will start as root and wpa_supplicant will switch to user wifi
 #  after setting up the capabilities required for WEXT
 #  user wifi
 #  group wifi inet keystore
    interface android.hardware.wifi.supplicant@1.0::ISupplicant default
    interface android.hardware.wifi.supplicant@1.1::ISupplicant default
    interface android.hardware.wifi.supplicant@1.2::ISupplicant default
    class late_start
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service hostapd /vendor/bin/hostapd_hisi
    interface android.hardware.wifi.hostapd@1.0::IHostapd default
    interface android.hardware.wifi.hostapd@1.1::IHostapd default
    class main
    capabilities NET_ADMIN NET_RAW
    user wifi
    group wifi net_raw net_admin
    disabled
    oneshot
